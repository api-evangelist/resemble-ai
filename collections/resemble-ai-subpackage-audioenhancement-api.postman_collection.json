          "id": "81a4abea-8c06-42ca-8d73-19cfcb473fc3",
          "name": "Create audio enhancement",
          "request": {
            "name": "Create audio enhancement",
            "description": {
              "content": "Submit an audio file for enhancement. Processing happens asynchronously in the background.\nThe API defaults to the v2 enhancement engine. The v1 engine is legacy and will be sunset in a future release.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "audio_enhancements"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "multipart/form-data"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "audio_file",
                  "type": "file",
                  "description": "(Required) Audio file to enhance (WAV, MP3, M4A, MP4, OGG, AAC, FLAC). Max 150 MB."
                },
                {
                  "key": "enhancement_engine",
                  "value": "v2",
                  "type": "text",
                  "description": "Enhancement engine to use. Default is v2."
                },
                {
                  "key": "remove_noise",
                  "value": "true",
                  "type": "text",
                  "description": "Remove background noise. Engine v2 only."
                },
                {
                  "key": "normalize",
                  "value": "true",
                  "type": "text",
                  "description": "Normalize audio levels. Engine v2 only."
                },
                {
                  "key": "studio_sound",
                  "value": "true",
                  "type": "text",
                  "description": "Apply studio-quality enhancement. Engine v2 only."
                },
                {
                  "key": "enhancement_level",
                  "value": "<double>",
                  "type": "text",
                  "description": "Enhancement intensity (0.0 to 1.0). Engine v1 only (legacy)."
                },
                {
                  "key": "loudness_target_level",
                  "value": "-14",
                  "type": "text",
                  "description": "Target loudness in LUFS. Engine v1 only (legacy)."
                },
                {
                  "key": "loudness_peak_limit",
                  "value": "-1",
                  "type": "text",
                  "description": "Peak limit in dBTP. Engine v1 only (legacy)."
                }
              ]
            }
          },
